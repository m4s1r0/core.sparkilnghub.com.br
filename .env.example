# Copie para .env e preencha as senhas locais. Nunca versione o .env.
# Valores aqui são apenas de desenvolvimento; senhas aparecem como __defina__.

# Ambiente: development | homologation | production
SPARK_ENV=development

# Servidor HTTP do SparkCore
HTTP_HOST=127.0.0.1
HTTP_PORT=3000

# Interface em desenvolvimento (Vite)
WEB_PORT=5173

# MySQL de desenvolvimento (compose.yaml expõe 3307 no host)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# Somente para o contêiner local criar bancos e usuários (docker/mysql/init)
MYSQL_ROOT_PASSWORD=__defina__

# Uma credencial por papel (research.md R-06)
MYSQL_MIGRATOR_PASSWORD=__defina__
MYSQL_WEB_PASSWORD=__defina__
MYSQL_WORKER_PASSWORD=__defina__
MYSQL_PROVISIONER_PASSWORD=__defina__

# Escritor da projeção de acesso nos bancos <instância>_acc (F01, research.md R-07)
MYSQL_ACCESS_WRITER_PASSWORD=__defina__

# Usuário dos testes de integração (bancos t_<runid>_*), só em desenvolvimento/CI
MYSQL_TEST_PASSWORD=__defina__

# Identidade (F01). Origem pública da interface, usada na verificação contra CSRF.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Chave AES-256 que cifra os segredos TOTP: 32 bytes em base64. Gere com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perdê-la obriga todos a recadastrar o TOTP; a versão acompanha cada segredo cifrado.
IDENTITY_SECRET_KEY=__defina__
IDENTITY_SECRET_KEY_VERSION=1

# Senha das contas sintéticas criadas por `npm run db:seed` (ana, bruno e carla@example.test);
# mínimo de 12 caracteres. Só em desenvolvimento e homologação.
SEED_USER_PASSWORD=__defina__
# Credencial de aplicação do produto de referência, impressa uma vez pelo `db:seed`
# (formato <id>.<segredo>). Opcional; só para exercitar /internal/v1 manualmente.
SPARKREF_APP_CREDENTIAL=
