{
  "name": "sparkcore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SparkCore — plataforma interna da Sparkling Hub",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "build:contracts": "tsc -b packages/contracts",
    "typecheck": "tsc -b && tsc -p server/tests --noEmit && tsc -p scripts --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "vitest run --project scripts",
    "check:adr": "tsx scripts/check-adr.ts",
    "gate": "tsx scripts/gate.ts",
    "dev:up": "tsx scripts/dev-up.ts",
    "dev:down": "tsx scripts/dev-down.ts",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "db:migrate": "tsx server/src/cli/db-migrate.ts",
    "db:seed": "tsx server/src/cli/db-seed.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check:ds": "tsx scripts/check-ds.ts",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test -c web/playwright.config.ts",
    "test:contract": "vitest run --project contract",
    "ref:validate": "tsx server/src/cli/ref-validate.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:upgrade": "tsx scripts/check-migration-upgrade.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify": "tsx scripts/verify.ts",
    "postinstall": "npm run build:contracts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
